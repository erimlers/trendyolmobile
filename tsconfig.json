{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false
  },
  "include": ["index.js", "App.tsx", "src/**/*.ts", "src/**/*.tsx", "__tests__/**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
